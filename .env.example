# Optional. The app works fully without it (deterministic Spanish templates).
ANTHROPIC_API_KEY=
# Optional model override for the nudge drafter.
ANTHROPIC_MODEL=claude-opus-5-5

# Optional. Use Cobre's Account Verification API as the ownership lookup (filter 2).
# Without these, a simulator answers instead.
COBRE_USER_ID=
COBRE_SECRET=
# Defaults to https://api.cobre.co/v1
COBRE_BASE_URL=
